                      <geom class="2f85/visual" mesh="base" material="2f85/black"/>
                      <geom class="2f85/collision" mesh="base"/>
                      <site name="pinch" pos="0 0 0.145"/>

                      <!-- Base collision approximation -->
                      <body name="hande" pos="0 0 0">
                        <geom mesh="coupler" class="visual" material="dark_gray" />
                        <geom mesh="hande" class="visual" material="dark_gray" />
                        <geom mesh="hande" class="collision" rgba="0.2 0.2 0.2 0.2" />

                      <geom type="cylinder" size="0.037 0.007" class="collision"/>
                      <geom type="cylinder" pos="0 0 0.014" size="0.037 0.007" class="collision2"/>
                      <geom type="cylinder" pos="0 0 0.021" size="0.034 0.007" class="collision2"/>
                      <geom type="cylinder" pos="0 0 0.025" size="0.032 0.007" class="collision2"/>
                      <geom type="cylinder" pos="0 0 0.05" size="0.025 0.03" class="collision2"/>
                      <geom type="cylinder" pos="0 0 0.075" size="0.032 0.007" class="collision2"/>
                      <geom type="cylinder" pos="0 0 0.071" size="0.03 0.007" class="collision2"/>
                      <geom type="cylinder" pos="0.005 0 0.088" size="0.032 0.01" class="collision2"/>
                      <geom type="cylinder" pos="-0.005 0 0.088" size="0.032 0.01" class="collision2"/>

                      <body name="hande_left_finger" pos="0 0 0.099">
                        <inertial
                            pos="0.02262 -0.00759 0.00738"
                            quat="0.871952 0.0369732 -0.211073 0.440205"
                            mass="0.03804"
                            diaginertia="1.22763e-05 1.22763e-05 1.22763e-05"
                        />
                        <joint name="hande_left_finger_joint" axis="1 0 0" class="finger_slide" />
